# Copy to deploy/nas/.env. Never commit your private environment file.
# Compose command: docker compose --env-file deploy/nas/.env up -d
APP_PASSWORD=replace-with-your-benefits-login-password
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=https://benefits.example.com
# Use an independent random hexadecimal password, without URI-special characters.
MONGO_APP_PASSWORD=replace-with-random-hexadecimal-database-password
MONGODB_DATABASE=benefits
APP_BIND=192.168.1.107
APP_PORT=18188
MONGO_UID_GID=1000:10
MONGODB_DATA_DIR=/volume1/docker/mongodb/data/benefits
